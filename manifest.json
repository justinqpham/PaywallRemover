{
   "action": {
      "default_icon": {
         "16": "images/icon.png",
         "24": "images/icon.png",
         "32": "images/icon.png"
      },
      "default_title": "Paywall Remover"
   },
   "author": "Justin Q Pham",
   "background": {
      "service_worker": "service_worker.js",
      "type": "module"
   },
   "content_security_policy": {
   },
   "description": "Open current pages in archive mirrors with one click",
   "icons": {
      "128": "images/icon.png",
      "16": "images/icon.png",
      "24": "images/icon.png",
      "32": "images/icon.png",
      "48": "images/icon.png"
   },
   "manifest_version": 3,
   "name": "Paywall Remover",
   "permissions": [ "activeTab", "contextMenus", "scripting", "storage", "tabs" ],
   "host_permissions": [
      "https://web.archive.org/*",
      "https://archive.is/*",
      "https://archive.ph/*",
      "https://archive.today/*",
      "https://api.unpaywall.org/*",
      "https://api.openalex.org/*",
      "https://api.crossref.org/*",
      "https://www.ebi.ac.uk/*",
      "https://api.core.ac.uk/*"
   ],
   "version": "0.11.0"
}
